uninstall_qbraid_code() {
  local assume_yes="$1" reply="" script_source script_dir script_file sidecar sidecar_home="" bound=0 runtime pid managed_link
  local normalized_home lexical_home physical_home physical_install install_parent install_name default_home marker_value="" has_sidecar=0
  case "$HOME_DIR" in /*) ;; *) echo 'qbraid-code: installation path is not absolute; refusing uninstall.' >&2; return 1 ;; esac
  normalized_home=$(printf '%s' "$HOME_DIR" | sed 's#//*#/#g')
  while [ "$normalized_home" != / ] && [ "${normalized_home%/}" != "$normalized_home" ]; do normalized_home=${normalized_home%/}; done
  HOME_DIR="$normalized_home"
  [ "$HOME_DIR" != / ] || { echo "qbraid-code: unsafe installation path '$HOME_DIR'; refusing uninstall." >&2; return 1; }
  [ ! -L "$HOME_DIR" ] || { echo "qbraid-code: installation path is a symlink; remove it manually." >&2; return 1; }
  case "/$HOME_DIR/" in */../*|*/./*)
    echo "qbraid-code: installation path contains dot segments; refusing uninstall." >&2
    return 1 ;;
  esac
  lexical_home=$(printf '%s' "${HOME%/}" | sed 's#//*#/#g')
  [ -n "$lexical_home" ] || lexical_home=/
  default_home="$lexical_home/.qbraid-code"
  physical_home=$(CDPATH='' cd -- "$HOME" 2>/dev/null && pwd -P) || {
    echo 'qbraid-code: could not resolve the user home directory.' >&2
    return 1
  }
  if [ -e "$HOME_DIR" ]; then
    [ -d "$HOME_DIR" ] || { echo 'qbraid-code: installation path is not a directory.' >&2; return 1; }
    physical_install=$(CDPATH='' cd -- "$HOME_DIR" 2>/dev/null && pwd -P) || physical_install=""
  else
    install_parent=$(dirname -- "$HOME_DIR")
    install_name=$(basename -- "$HOME_DIR")
    physical_install=$(CDPATH='' cd -- "$install_parent" 2>/dev/null && printf '%s/%s' "$(pwd -P)" "$install_name") || physical_install=""
  fi
  if [ "$HOME_DIR" != "$default_home" ] && [ "$physical_install" != "$HOME_DIR" ]; then
    echo 'qbraid-code: custom installation path uses a symbolic-link component or alias; refusing uninstall.' >&2
    return 1
  fi
  [ "$physical_install" != "$physical_home" ] || {
    echo "qbraid-code: installation path resolves to the user home; refusing uninstall." >&2
    return 1
  }
  if [ -d "$HOME_DIR" ]; then
    command -v find >/dev/null 2>&1 || { echo 'qbraid-code: find is required to verify uninstall paths.' >&2; return 1; }
    managed_link=$(find "$HOME_DIR" -type l -print -quit 2>/dev/null) || {
      echo 'qbraid-code: could not verify uninstall paths.' >&2
      return 1
    }
    [ -z "$managed_link" ] || {
      echo "qbraid-code: refusing to traverse symbolic link '$managed_link'." >&2
      return 1
    }
  fi

  script_source=${BASH_SOURCE[0]}
  script_dir=$(CDPATH='' cd -- "$(dirname -- "$script_source")" 2>/dev/null && pwd -P) || script_dir=""
  script_file="$script_dir/$(basename -- "$script_source")"
  sidecar="$script_file.home"
  if [ -f "$sidecar" ]; then
    has_sidecar=1
    IFS= read -r sidecar_home < "$sidecar" || true
    sidecar_home=$(printf '%s' "$sidecar_home" | sed 's#//*#/#g')
    while [ "$sidecar_home" != / ] && [ "${sidecar_home%/}" != "$sidecar_home" ]; do sidecar_home=${sidecar_home%/}; done
    [ "$sidecar_home" = "$HOME_DIR" ] && bound=1
    [ "$bound" -eq 1 ] || { echo 'installation is not bound by this launcher; refusing uninstall.' >&2; return 1; }
  fi
  if [ "$HOME_DIR" != "$default_home" ]; then
    [ "$has_sidecar" -eq 1 ] && [ "$bound" -eq 1 ] || {
      echo 'qbraid-code: custom installation is not bound by this launcher; refusing uninstall.' >&2
      return 1
    }
    if [ -d "$HOME_DIR" ]; then
      marker_value=$(cat "$HOME_DIR/.qbraid-code-install" 2>/dev/null || true)
      [ "$marker_value" = qbraid-code ] || {
        echo 'qbraid-code: custom installation lacks its ownership marker. Re-run the installer before uninstalling.' >&2
        return 1
      }
    fi
  fi

  if [ "$assume_yes" -ne 1 ]; then
    if ! (exec 3</dev/tty) 2>/dev/null || ! (exec 3>/dev/tty) 2>/dev/null; then
      echo 'qbraid-code: uninstall needs a terminal. Re-run with --uninstall --yes.' >&2
      return 1
    fi
    printf 'Type uninstall to delete local qbraid-code profiles, keys, and files: ' > /dev/tty
    IFS= read -r reply < /dev/tty || true
    [ "$reply" = uninstall ] || { echo 'qbraid-code: uninstall cancelled.' >&2; return 1; }
  fi

  trap cleanup_uninstall_locks EXIT
  trap 'cleanup_uninstall_locks; exit 130' INT
  trap 'cleanup_uninstall_locks; exit 143' TERM
  trap 'cleanup_uninstall_locks; exit 129' HUP
  acquire_uninstall_locks || return 1
  uninstall_has_live_work && return 1
  preflight_secret_cleanup || return 1
  preflight_claude_integrations || return 1

  for runtime in "$HOME_DIR"/runtime.*; do
    [ -d "$runtime" ] || continue
    pid=$(cat "$runtime/proxy.pid" 2>/dev/null || true)
    stop_owned_process "$pid" "$runtime/proxy-config.yaml" || return 1
  done
  pid=$(cat "$HOME_DIR/proxy.pid" 2>/dev/null || true)
  stop_owned_process "$pid" "$HOME_DIR/proxy-config.yaml" || return 1

  cleanup_claude_integrations || return 1
  remove_local_secrets || return 1
  remove_orphaned_store_secrets || return 1
  rm -rf -- "$HOME_DIR" || return 1
  [ ! -e "$HOME_DIR" ] || { echo "qbraid-code: could not remove $HOME_DIR" >&2; return 1; }

  if [ "$bound" -eq 1 ]; then
    rm -f -- "$sidecar" || return 1
    rm -f -- "$script_file" || return 1
  fi
  echo 'qbraid-code: local installation removed. qBraid account API keys were not revoked.'
}

